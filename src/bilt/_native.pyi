class AtomType:
    name: str

    def __init__(self, name: str) -> None: ...

class Atom:
    atom_type: AtomType
    value: str

    def __init__(self, atom_type: AtomType, value: str) -> None: ...

class Tree:
    head: Atom
    args: list[Tree]

    def __init__(self, head: Atom, args: list[Tree]) -> None: ...
    def is_leaf(self) -> bool: ...
    def is_binary(self) -> bool: ...
    def left(self) -> Tree | None: ...
    def right(self) -> Tree | None: ...
